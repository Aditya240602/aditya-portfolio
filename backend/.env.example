PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio
# Comma-separated origins allowed to call the API (your deployed portfolio URL)
ALLOWED_ORIGINS=http://localhost:5500,https://your-portfolio.vercel.app
# Long random string; needed for moderation (DELETE /api/guestbook/:id, GET /api/contact)
ADMIN_TOKEN=change-me-to-a-long-random-string
